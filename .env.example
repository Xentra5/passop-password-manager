# PassVault Environment Variables
# Copy this file to .env and fill in real values for your deployment.
# NEVER commit .env to git — it is already in .gitignore.

# Backend API base URLs — MUST use https:// in production
# BUG #6 FIX: Replace localhost with your production domain
VITE_AUTH_API_URL=http://localhost:3000/api/auth
VITE_API_BASE_URL=http://localhost:3000/api/passwords
